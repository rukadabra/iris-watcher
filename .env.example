# Bot → Privileged Gateway Intents → Message Content Intent: ON
# https://docs.discord.com/developers/events/gateway#message-content-intent
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Redirect OAuth yang didaftarkan di Developer Portal:
# ${WEB_ORIGIN}/api/auth/callback
# Dashboard memakai DISCORD_TOKEN untuk daftar channel teks, dan PLAYER_URL untuk menambah channel YouTube.
WEB_ORIGIN=http://localhost:3000
DEFAULT_PREFIX=!iris

# URL Postgres dan Redis. Lokal menunjuk ke 127.0.0.1. Di Dokploy, isi layanan yang sudah ada.
DATABASE_URL=postgresql://iris:iris@127.0.0.1:5432/iris
REDIS_URL=redis://127.0.0.1:6379
HEALTH_PORT=8081

# Alamat service YouTube.
PLAYER_URL=http://127.0.0.1:8090
PLAYER_TOKEN=
PLAYER_HOST=127.0.0.1
PLAYER_PORT=8090
