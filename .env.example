# Bot → Privileged Gateway Intents → Message Content Intent: ON
# https://docs.discord.com/developers/events/gateway#message-content-intent
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Redirect OAuth yang didaftarkan di Developer Portal:
# ${WEB_ORIGIN}/api/auth/callback
# Dashboard memakai DISCORD_TOKEN untuk daftar channel teks, dan PLAYER_URL untuk menambah channel YouTube.
WEB_ORIGIN=http://localhost:3000
DEFAULT_PREFIX=!iris

# URL untuk `pnpm dev` di mesin ini. Di dalam kontainer, compose mengarah ke hostname postgres dan redis.
POSTGRES_PASSWORD=iris
DATABASE_URL=postgresql://iris:iris@127.0.0.1:5432/iris
REDIS_URL=redis://127.0.0.1:6379
HEALTH_PORT=8081

# Alamat service YouTube.
PLAYER_URL=http://127.0.0.1:8090
PLAYER_TOKEN=
PLAYER_HOST=127.0.0.1
PLAYER_PORT=8090

# Rahasia untuk mengenkripsi API key AI milik tiap server. Bot dan web harus memakai nilai yang sama.
# Buat dengan: openssl rand -base64 32
# Jangan diganti begitu saja: key yang sudah tersimpan tidak bisa dibuka lagi.
# Untuk rotasi, pindahkan nilai lama ke AI_KEY_SECRET_PREVIOUS lalu isi AI_KEY_SECRET dengan nilai baru.
AI_KEY_SECRET=
AI_KEY_SECRET_PREVIOUS=
