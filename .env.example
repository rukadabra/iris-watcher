# Bot → Privileged Gateway Intents → Message Content Intent: ON
# https://docs.discord.com/developers/events/gateway#message-content-intent
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth redirect registered in the Developer Portal:
# ${WEB_ORIGIN}/api/auth/callback
# The dashboard uses DISCORD_TOKEN to list text channels and PLAYER_URL to add YouTube channels.
WEB_ORIGIN=http://localhost:3000
DEFAULT_PREFIX=!iris

# URL for `pnpm dev` on this machine. Inside a container, compose points at the postgres and redis hostnames.
POSTGRES_PASSWORD=iris
DATABASE_URL=postgresql://iris:iris@127.0.0.1:5432/iris
REDIS_URL=redis://127.0.0.1:6379
HEALTH_PORT=8081

# Address of the YouTube service.
PLAYER_URL=http://127.0.0.1:8090
PLAYER_TOKEN=
PLAYER_HOST=127.0.0.1
PLAYER_PORT=8090

# Secret used to encrypt each server's AI API key. The bot and the web must use the same value.
# Create one with: openssl rand -base64 32
# Do not replace it carelessly: saved keys can no longer be opened.
# For rotation, move the old value to AI_KEY_SECRET_PREVIOUS and set AI_KEY_SECRET to the new value.
AI_KEY_SECRET=
AI_KEY_SECRET_PREVIOUS=
