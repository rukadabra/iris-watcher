{
  "name": "@iris/bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "sh -c 'set -- src/*.test.ts; if [ -e \"$1\" ]; then exec tsx --test \"$@\"; fi'"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@iris/db": "workspace:*",
    "@iris/shared": "workspace:*",
    "discord.js": "14.27.0",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "opusscript": "0.0.8",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
